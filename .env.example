# Copy to .env (chmod 600). Every variable is optional.
# Tokens must be at least 32 characters, e.g.: openssl rand -hex 32

# TZ=Europe/Kyiv
# FUEL_PORT=3050
# SESSION_DAYS=90
# COOKIE_SECURE=1
# Reverse proxies allowed to set X-Forwarded-For: hostnames (resolved via DNS) and/or IPs
# TRUSTED_PROXY_HOSTS=caddy
# TRUSTED_PROXIES=

# Home location for nearby fuel prices and weather (default: Kyiv), and the
# Minfin region slug from index.minfin.com.ua/ua/markets/fuel/reg/<slug>/
# HOME_LAT=50.450
# HOME_LNG=30.523
# PRICE_REGION=kievskaya

# 0 disables background jobs that call external services
# (fuel prices from WOG/OKKO/Minfin, weather for service reminders)
# PRICES=0

# Home Assistant hooks (/api/hook/*)
# FUEL_HOOK_TOKEN=

# Family Budget sync (the companion family-budget app): same token as the
# budget's BUDGET_HOOK_TX_TOKEN
# BUDGET_URL=http://budget:8080
# BUDGET_HOOK_TX_TOKEN=

# cmintey/wishlist: show items tagged #<tag> from a public list
# WISHLIST_URL=http://wishlist:3280
# WISHLIST_LIST=
# WISHLIST_PUBLIC=https://wish.example.com
# Telegram bot that adds items to the list (shown as a hint)
# WISHLIST_BOT=
